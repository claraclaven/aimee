# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ----- DATA: Zetaris (Participant Guide §1.9) -----
# REST base URL of your local Zetaris install.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Organisation ID is 1 on a local install.
ZETARIS_ORG_ID=1
# Create an API key in the Zetaris web UI (localhost:3000) and paste it here.
ZETARIS_API_KEY=your-zetaris-api-key
# The Zetaris catalog/database that holds the opportunity tables we register.
ZETARIS_CATALOG=opportunities

# ----- POWER: Meterless Nightshift (Participant Guide §4.5) -----
# From Nightshift's Console: Runtime base URL and access token.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Routing mode (not an NVIDIA model id). e.g. meterless/auto
METERLESS_MODEL=meterless/auto
